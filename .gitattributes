# 统一换行符，避免 Windows / macOS 协作时整文件 diff
* text=auto eol=lf

# Windows 脚本必须是 CRLF，否则 cmd.exe 解析 label / 多行块会出问题
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.bin binary
*.safetensors binary
*.onnx binary
*.npy binary
