# ==========================================
# 环境变量模板
# 用法：复制为 .env.local（或在根目录建 config.override.json）
# 填好真实值后再启动后端。.env.local 已被 .gitignore 排除。
# ==========================================

# ---------- 运行环境 ----------
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# ---------- 嵌入模型提供方 ----------
# local    : 本地 BGE-M3（需要 torch + 模型文件，离线可用）—— 默认
# dashscope: 阿里云百炼（不需要 torch、不需要下载模型，按量计费）
# 注意：两种模式的向量不在同一个空间，切换必须重建索引；
#      远程模式会自动使用独立的 Milvus 集合（km_chunks__ds_xxx）
EMBEDDING_PROVIDER=local
# 向量维度，必须与 Milvus 集合一致；百炼 v3/v4 支持 1024/768/512/256/128/64
EMBEDDING_DIM=1024

# ---------- 阿里云百炼（EMBEDDING_PROVIDER=dashscope 时必填）----------
# https://bailian.console.aliyun.com 申请，各模型有 100 万 token 免费额度（90 天）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# 百炼 v3/v4 单次请求上限 10 条，超过会 400，不要调大
DASHSCOPE_BATCH_SIZE=10
DASHSCOPE_TIMEOUT=30
DASHSCOPE_MAX_RETRIES=2

# ---------- BGE-M3 嵌入模型（EMBEDDING_PROVIDER=local 时生效）----------
# Windows 示例：H:/models/bge-m3
# Linux 示例  ：/opt/models/bge-m3
# Docker 示例 ：/app/models/bge-m3
BGE_MODEL_PATH=/path/to/bge-m3
# cuda / cpu，没有显卡就写 cpu（只是慢一些）
BGE_DEVICE=cuda
BGE_BATCH_SIZE=16
BGE_MAX_LENGTH=1024

# ---------- DeepSeek LLM ----------
# https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ---------- MySQL ----------
# 用 docker-compose.dev.yml 起库时宿主机端口是 3307；
# 本机自己装 MySQL 默认是 3306。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=knowledge_manager

# ---------- Milvus ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=km_chunks

# ---------- 文件路径 ----------
# 留空则默认使用 <项目根>/data/documents 与 <项目根>/data/uploads
DOCUMENTS_PATH=/path/to/data/documents
UPLOAD_PATH=/path/to/data/uploads

# ---------- 文本分块 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- 检索 ----------
SEARCH_TOP_K=5
SCORE_THRESHOLD=0.0

# ---------- 问答缓存：交叉编码器重排（可选，缺失会自动降级） ----------
QA_RERANKER_ENABLED=true
QA_RERANKER_PATH=/path/to/bge-reranker-large
# 0.995 是标定出来的零误判阈值，不要随意下调
QA_RERANK_THRESHOLD=0.995
